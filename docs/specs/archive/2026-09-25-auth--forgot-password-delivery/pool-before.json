        "EmailVerificationMessage": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background-color:#F7F7F7;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F7F7F7;\">\n      <tr>\n        <td align=\"center\" style=\"padding:24px 12px;\">\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border:1px solid #E2E2E2;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;\">\n            <tr>\n              <td style=\"background-color:#1F4E8C;padding:20px 32px;\">\n                <span style=\"color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:0.5px;\">ACCELERATE Seed Registry</span>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;color:#333333;font-size:15px;line-height:1.6;\">\n                <p style=\"margin:0 0 16px;\">We received a request to reset your password for the ACCELERATE Seed Registry admin portal.</p>\n                <p style=\"margin:0 0 8px;\">Enter this verification code to set a new password:</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin:0 0 24px;background-color:#F7F7F7;border:1px solid #E2E2E2;border-radius:6px;\">\n                  <tr>\n                    <td align=\"center\" style=\"padding:20px;color:#1F4E8C;font-size:28px;font-weight:bold;letter-spacing:4px;\">{####}</td>\n                  </tr>\n                </table>\n                <p style=\"margin:0;color:#666666;font-size:13px;line-height:1.6;\">This code expires shortly. If you did not request a password reset, you can safely ignore this email.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
        "EmailVerificationSubject": "Your ACCELERATE Seed Registry verification code",
        "VerificationMessageTemplate": {
            "EmailMessage": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background-color:#F7F7F7;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F7F7F7;\">\n      <tr>\n        <td align=\"center\" style=\"padding:24px 12px;\">\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border:1px solid #E2E2E2;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;\">\n            <tr>\n              <td style=\"background-color:#1F4E8C;padding:20px 32px;\">\n                <span style=\"color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:0.5px;\">ACCELERATE Seed Registry</span>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;color:#333333;font-size:15px;line-height:1.6;\">\n                <p style=\"margin:0 0 16px;\">We received a request to reset your password for the ACCELERATE Seed Registry admin portal.</p>\n                <p style=\"margin:0 0 8px;\">Enter this verification code to set a new password:</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin:0 0 24px;background-color:#F7F7F7;border:1px solid #E2E2E2;border-radius:6px;\">\n                  <tr>\n                    <td align=\"center\" style=\"padding:20px;color:#1F4E8C;font-size:28px;font-weight:bold;letter-spacing:4px;\">{####}</td>\n                  </tr>\n                </table>\n                <p style=\"margin:0;color:#666666;font-size:13px;line-height:1.6;\">This code expires shortly. If you did not request a password reset, you can safely ignore this email.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
