            "InviteMessageTemplate": {
                "EmailMessage": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background-color:#F7F7F7;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F7F7F7;\">\n      <tr>\n        <td align=\"center\" style=\"padding:24px 12px;\">\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border:1px solid #E2E2E2;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;\">\n            <tr>\n              <td style=\"background-color:#1F4E8C;padding:20px 32px;\">\n                <span style=\"color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:0.5px;\">ACCELERATE Seed Registry</span>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;color:#333333;font-size:15px;line-height:1.6;\">\n                <p style=\"margin:0 0 16px;\">Welcome! An administrator has created an account for you on the ACCELERATE Seed Registry admin portal.</p>\n                <p style=\"margin:0 0 8px;\">Use these credentials to sign in for the first time:</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin:0 0 24px;background-color:#F7F7F7;border:1px solid #E2E2E2;border-radius:6px;\">\n                  <tr>\n                    <td style=\"padding:16px 20px;color:#333333;font-size:15px;line-height:1.8;\">\n                      <div><span style=\"color:#666666;\">Username:</span> <strong>{username}</strong></div>\n                      <div><span style=\"color:#666666;\">Temporary password:</span> <strong>{####}</strong></div>\n                    </td>\n                  </tr>\n                </table>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"border-radius:6px;background-color:#1F4E8C;\">\n                      <a href=\"https://d3idqvvg0xa1r7.cloudfront.net/login\" style=\"display:inline-block;padding:12px 28px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;\">Sign in to the portal</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:24px 0 4px;color:#666666;font-size:13px;line-height:1.6;\">Or open this link: https://d3idqvvg0xa1r7.cloudfront.net/login</p>\n                <p style=\"margin:16px 0 0;color:#666666;font-size:13px;line-height:1.6;\">You will be asked to set a new password when you first sign in. If you did not expect this email, you can safely ignore it.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
