# Copy to .env for local dev (never commit the real .env).
#
# Vars are grouped by when the backend actually needs them. Most are read
# LAZILY — only the first time the code path that needs them runs, not at
# boot (auth.config.ts, mail.config.ts, email-verification.config.ts,
# admin-recipient.resolver.ts all follow this pattern deliberately, so a
# checkout with only the "required to boot" group set still starts and
# serves every public route). A missing var on a lazy path throws a clear
# "Missing required env var ..." error only when that path is exercised.

# ── Required to boot ────────────────────────────────────────────────────
# PrismaService connects on module init, so every route needs this.
# Point it at your local MySQL 8 (docker `accelerate-mysql` on
# localhost:3306 is the safer rehearsal target per backend/CLAUDE.md; the
# shared dev RDS also works if you don't have a local MySQL running).
DATABASE_URL=mysql://user:pass@localhost:3306/accelerate

# Local HTTP port for `npm run start` (main.ts). Lambda uses lambda.ts
# instead and ignores this.
# KEEP THIS SET. main.ts defaults to 3000 when unset — the SAME port the
# Next.js dev server uses — so leaving it out makes whichever process starts
# second fail to bind. 3001 is the port docs/infrastructure.md §6 documents
# and the port frontend/.env.example points NEXT_PUBLIC_API_BASE_URL at.
PORT=3001

# Origin allowed by the local-only CORS policy in main.ts. Optional —
# defaults to http://localhost:3000. Set it only if the Next.js dev server
# picked a different port (it does that automatically when 3000 is busy;
# it prints the port it chose on startup).
# LOCAL_CORS_ORIGIN=http://localhost:3000

# ── Mail — contact form + registration OTP emails ──────────────────────
# Which transport MailService sends through: "microservice" or "no-op".
# Use "no-op" for local dev — it logs the message instead of calling a real
# transport, so no broker connection is needed to run the app locally. This
# is the local default; only switch to "microservice" to test real delivery.
MAIL_TRANSPORT=no-op

# ── Mail — OneCGIAR notification microservice (enhancement/
#    email-notification-microservice, FR-7, FR-8) ───────────────────────
# Only read when MAIL_TRANSPORT=microservice (getMicroserviceMailConfig).
# Four of the five throw if unset; EMAIL_SENDER_NAME is the one that
# defaults instead. Leave all five unset for "no-op" — none are read.
# Placeholders only below — never put a real broker URL or API key in a
# committed file (FR-8's BUT). In the deployed Lambda, RABBITMQ_URL and
# MICROSERVICE_API_KEY come from Secrets Manager dynamic references only
# (infra/20-backend/template.yaml MailMicroserviceSecret) — never a literal.
#
# Broker URL (embeds credentials as amqps://user:pass@host/vhost). Held by
# the platform team (design.md §4.5 — matches EMAIL_QUEUE_NAME/EMAIL_SENDER
# below); deployed value is populated into MailMicroserviceSecret by the
# operator, never here.
# ⚠️ withHeartbeat round-trips this through WHATWG `URL` and
# `searchParams.set` re-serializes the WHOLE query string — lossless for
# credentials/host/vhost, but not byte-preserving if the URL already
# carries query parameters. Don't add any.
# RABBITMQ_URL=amqps://user:pass@broker.example.org:5671/vhost

# Queue name the microservice consumes from. Source: the platform team.
# EMAIL_QUEUE_NAME=your-queue-name

# CLARISA-issued API key authenticating this app to the microservice.
# MICROSERVICE_API_KEY=your-clarisa-api-key

# Verified sender address for the microservice. Source: the platform team.
# EMAIL_SENDER=you@example.org

# Display name prefixed to outbound mail. Optional — defaults to the fixed
# project value below (a trailing "-" is deliberate; the microservice
# appends " No reply" to render "... - No reply"). Source: fixed project
# value, not the platform team or CLARISA.
# EMAIL_SENDER_NAME=ACCELERATE Tanzania Seed Registry -

# ── Cognito — staff/admin auth, admin user management, contact-form
#    recipient resolution ────────────────────────────────────────────────
# Only read when a request actually needs a Cognito call: the JWT guard on
# staff/admin routes (auth.config.ts), the admin user-management endpoints
# (cognito-admin.client.ts), and the public contact form's admin-group
# recipient lookup (admin-recipient.resolver.ts). Leave unset to develop
# the public read-only routes; anything gated by these throws a clear
# error at first use, not at boot.
# COGNITO_USER_POOL_ID=<your dev Cognito user pool id>
# COGNITO_CLIENT_ID=<your dev Cognito app client id>

# AWS SDK region for the Cognito calls above (auth.config.ts,
# cognito-admin.client.ts). The deployed Lambda gets this from the runtime
# automatically — set it locally only if you exercise those paths. No
# longer read by mail.config.ts — the notification microservice transport
# takes no AWS region (enhancement/email-notification-microservice, T-10).
# AWS_REGION=eu-west-1

# Fallback recipient for the public contact form (admin-recipient.
# resolver.ts, FR-3) — used when the Cognito `admin` group resolves empty
# or the directory call fails.
# KEEP THIS SET for local dev. With no Cognito credentials the group lookup
# always fails, the resolver falls back to this var, and if it is unset the
# request fails with a 500 — so POST /api/v1/contact does not work locally
# without it. The address is never contacted while MAIL_TRANSPORT=no-op, so
# any placeholder is fine; the composed message is printed to the console.
CONTACT_FALLBACK_RECIPIENT=local-dev@example.org

# ── Public app URL — applicant-facing links in emails ──────────────────
# Base URL of the web application. Mail templates build their links from
# it — today the registration receipt's status-lookup link (ATP-67). It
# used to be a CloudFront domain hardcoded in receipt.template.ts, which
# would have gone stale silently the day the app moved: the email keeps
# pointing at the old address and nothing fails.
#
# REQUIRED to send a registration receipt, and validated — it must be an
# absolute http(s) URL. An unset or unusable value throws, which
# RegistrationsService.dispatchReceiptEmail catches and logs, so the cost
# is the receipt email, never the registration itself. Deployed, the
# backend stack sets it from its PublicAppBaseUrl parameter, which falls
# back to AllowedOrigin (the live CloudFront URL). No trailing slash.
PUBLIC_APP_BASE_URL=http://localhost:3000

# ── Registrations — public self-registration OTP ───────────────────────
# HMAC key OTP codes are hashed under before storage/comparison — codes
# are never stored or compared in plaintext (email-verification.
# config.ts). Required only to exercise POST /api/v1/registrations/verify
# or the OTP-gated registration flow. Any placeholder string works
# locally; it is not a real secret outside a deployed environment.
# OTP_HMAC_SECRET=local-dev-otp-secret-change-me

# ── Import — admin bulk CSV import legal gate ───────────────────────────
# Deliberate ops-only safety flag: ImportService.runImport() refuses to
# execute unless this is exactly "true". Not wired to any route today
# (execution-deferred behind legal ratification) — leave unset for local
# dev.
# IMPORT_LEGAL_GATE_RATIFIED=true

# ── Lambda-only — do not set these locally ──────────────────────────────
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSL: PrismaService
# composes a connection URL from these when DB_HOST is present — this is
# how infra/20-backend/template.yaml wires the CloudFormation data-auth
# stack exports into the Lambda. Setting DB_HOST here would override
# DATABASE_URL above and bypass it. Use DATABASE_URL for local dev.
