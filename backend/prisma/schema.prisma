// Prisma schema — ACCELERATE Tanzania Seed Registry
// T-1 scaffold: datasource + generator only.
// T-2: Actor / Crop / CropsOnActors models + ConsentStatus enum (design.md §5).

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the nodejs20.x Lambda
  // runtime (Amazon Linux 2023 / OpenSSL 3) so the deployed function ships the
  // matching query engine binary (infra/aws-deployment T-3, design.md §4/§9).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ConsentStatus {
  GRANTED
  DENIED
  UNKNOWN
}

enum RegistrationSource {
  TEAM_MANAGED
  SELF_REGISTERED
}

enum ConsentMethod {
  NOT_RECORDED
  PORTAL_CHECKBOX
  SIGNED_FORM
  EMAIL
  VERBAL_FIELD
}

model Actor {
  id                 String             @id @default(cuid())
  traderId           String             @unique
  traderName         String
  region             String
  district           String?
  traderType         String
  sex                String?
  position           String?
  marketLocation     String?
  capacityTons       Decimal?           @db.Decimal(10, 2)
  technicalSupport   String?            @db.Text
  phone              String? // PII
  email              String? // PII
  gpsLatitude        Decimal?           @db.Decimal(10, 7)
  gpsLongitude       Decimal?           @db.Decimal(10, 7)
  gpsAltitude        Decimal?           @db.Decimal(10, 2)
  gpsAccuracy        Decimal?           @db.Decimal(10, 2)
  consentStatus      ConsentStatus      @default(UNKNOWN)
  registrationSource RegistrationSource @default(TEAM_MANAGED)
  consentMethod      ConsentMethod      @default(NOT_RECORDED)
  consentObtainedAt  DateTime?
  consentReference   String?            @db.VarChar(255)
  crops              CropsOnActors[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([region])
  @@index([traderType])
  @@index([consentStatus])
  @@index([traderName])
  @@index([registrationSource])
}

model Crop {
  id     String          @id @default(cuid())
  name   String          @unique // "sorghum" | "common_bean" | "groundnut"
  actors CropsOnActors[]
}

model CropsOnActors {
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId String
  crop    Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropId  String

  @@id([actorId, cropId])
}

enum ActorAuditAction {
  CREATE
  UPDATE
  DELETE
  BULK_CONSENT
  BULK_DELETE
  IMPORT
}

model ActorAuditLog {
  id           String           @id @default(cuid())
  // Plain string — deliberately NO relation/FK so rows survive actor deletion.
  actorId      String
  // Identity snapshot so history stays meaningful after deletion.
  traderId     String
  traderName   String
  action       ActorAuditAction
  actingSub    String
  actingEmail  String?
  changes      Json
  acknowledged Boolean?
  createdAt    DateTime         @default(now())

  @@index([actorId, createdAt])
}

// Public self-registration (docs/specs/actors/public-self-registration, T-1).
// PENDING_REVIEW / APPROVED / REJECTED are reachable by chunk 3a+3b; AWAITING_APPLICANT
// and WITHDRAWN are declared now so chunk 4 needs no enum migration (design.md §2.1).
enum RegistrationStatus {
  PENDING_REVIEW
  AWAITING_APPLICANT
  APPROVED
  REJECTED
  WITHDRAWN
}

// The full model, including adjudication columns 3a never writes, so chunk 3b
// (docs/specs/admin/registration-review-queue) needs no migration of its own
// (design.md §2.2, requirements.md §10).
model Registration {
  id                   String             @id @default(cuid())
  // Applicant-facing: REG-<year>-<4-digit sequence>. Never the internal id.
  reference            String             @unique
  status               RegistrationStatus @default(PENDING_REVIEW)
  // The submission. PII-bearing, admin-only in its entirety — never spread
  // into a public response.
  payload              Json
  // PII. The OTP-verified address — this is the address published as
  // Actor.email on approval (design.md §4.1, S-6).
  submitterEmail       String
  // Non-nullable by design: a row cannot exist unverified.
  emailVerifiedAt      DateTime
  // The applicant's acceptance time, not the write time.
  consentAcceptedAt    DateTime
  // The version the applicant was shown, echoed by the client, validated
  // server-side (FR-3).
  consentPolicyVersion String

  // --- Adjudication (chunk 3b writes these; 3a declares them) ---
  // Plain string, no FK — mirrors ActorAuditLog.actorId, deliberately FK-less.
  publishedActorId    String?
  reviewedBySub       String?
  reviewedByEmail     String?
  reviewedAt          DateTime?
  rejectionReason     String?
  // Applicant-facing — the one field the public lookup may return.
  reviewNote          String?   @db.Text
  // Per-candidate, not row-level: the set of candidate actor ids a reviewer
  // has cleared, each with who and when (design.md §2.2).
  duplicateDismissals Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The queue's only access pattern: status segment, oldest-first (design.md
  // §2.2). No index on submitterEmail — the lookup keys on `reference`.
  @@index([status, createdAt])
}

// Pre-Registration OTP store. No row exists until an applicant requests a
// code; a Registration row exists only once the code has been verified
// (design.md §2.3).
model EmailVerification {
  id String @id @default(cuid())

  // PII. Lowercased. The lookup key (design.md §4.3) — not unique: up to
  // three live codes per address are permitted by design.
  email      String
  // HMAC-SHA-256 under a server secret. Plaintext never stored, never logged.
  codeHash   String
  // Incremented on every verification attempt, right or wrong.
  attempts   Int       @default(0)
  expiresAt  DateTime
  // Single-use.
  consumedAt DateTime?
  // Also the per-email send-rate window.
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}
