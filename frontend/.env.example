# Copy to .env.local for local dev.
#
# Base URL for the NestJS REST API. The frontend throws a clear
# "NEXT_PUBLIC_API_BASE_URL is not set" error at first API call if this is
# empty, so it must have a value even for local dev.
#
# LOCAL: the backend listens on 3001 (backend/.env sets PORT=3001). The value
# below works as-is with the local stack in docs/infrastructure.md §6.
# DEPLOYED: the CloudFront /api prefix or the API Gateway stage URL, e.g.
#   https://abc123.execute-api.eu-west-1.amazonaws.com/dev
#
# Next.js inlines NEXT_PUBLIC_* at build time, so changing this needs a
# dev-server restart (or a rebuild for a static export).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# GA4 measurement ID for usage analytics (see docs/specs/enhancement/usage-analytics/).
# `GoogleAnalytics` renders nothing and throws nothing when this is empty (FR-7),
# so local dev works fine without it.
#
# Deliberately LEFT EMPTY here. Do NOT fill this in for local dev — doing so
# would send development traffic into the real GA4 property and pollute its
# data. The deployed build gets its value from `GA_MEASUREMENT_ID` in
# infra/scripts/deploy-frontend.sh (which carries a committed, non-secret
# default — a GA4 measurement ID is public in every page's source).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
