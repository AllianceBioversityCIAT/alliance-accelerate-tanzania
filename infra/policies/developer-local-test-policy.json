{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendThroughTheVerifiedRegistrySender",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:eu-west-1:ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "VerifyRecipientsWhileInSandbox",
      "Effect": "Allow",
      "Action": [
        "ses:VerifyEmailIdentity",
        "ses:ListIdentities",
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSendingStatus",
      "Effect": "Allow",
      "Action": [
        "ses:GetSendQuota",
        "ses:GetAccountSendingEnabled"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResolveContactRecipientsFromAdminGroup",
      "Effect": "Allow",
      "Action": "cognito-idp:ListUsersInGroup",
      "Resource": "arn:aws:cognito-idp:eu-west-1:ACCOUNT_ID:userpool/USER_POOL_ID"
    },
    {
      "Sid": "ReadStackOutputsAndCallerIdentity",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
